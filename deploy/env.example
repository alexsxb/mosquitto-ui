# Copy to .env and fill in. Never commit .env.

# --- Broker -----------------------------------------------------------------------------------------------------
# Password of the broker user "admin", set on the first start: at least 12 characters (openssl rand -base64 24).
# Later changes here do not reach the broker. Better: give the UI a user of its own with the role dynsec-admin.
MOSQUITTO_PASSWORD=
#MOSQUITTO_USERNAME=admin
MQTT_PORT=1883
MQTTS_PORT=8883

# --- Login ------------------------------------------------------------------------------------------------------
# UI users and identity providers (Keycloak, authentik, Google, GitHub ...) are set up on the page Login. Until a provider
# is on, the local login is: the first start creates "admin" with MOSQUITTO_UI_LOCAL_AUTH_INITIAL_PASSWORD, or with a
# generated password in the state volume (initial-password, gone after the first login):
#   docker compose exec mosquitto-ui cat /var/lib/mosquitto-ui/initial-password
# local keeps the local login on whatever the page says: the way back in when nobody can log in at the provider
MOSQUITTO_UI_AUTH=oidc
#MOSQUITTO_UI_LOCAL_AUTH_INITIAL_PASSWORD=
# Of versions before 0.26 only: become a provider at the first start of 0.26 (letting in MOSQUITTO_UI_ADMIN_ROLE), not read
# afterwards. New installations leave them empty.
#OIDC_ISSUER=https://sso.example.com/realms/example
#OIDC_CLIENT_ID=mosquitto-ui
#OIDC_CLIENT_SECRET=
#MOSQUITTO_UI_ADMIN_ROLE=mosquitto-admin

# --- Secrets ----------------------------------------------------------------------------------------------------
# Encrypts secrets in the state volume and signs backups (openssl rand -base64 32). Keep it apart from the volume and
# with your backups: it cannot change later. Empty: a key is generated in the state volume.
MOSQUITTO_UI_SECRET_KEY=

# --- Container --------------------------------------------------------------------------------------------------
# Version of both images, which belong together; better a fixed one than latest
MOSQUITTO_UI_VERSION=latest
# Where both images come from; empty: ghcr.io/alexsxb
MOSQUITTO_UI_REGISTRY=
MOSQUITTO_UI_PORT=8080
MOSQUITTO_UI_MEMORY=512m
# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated addresses/CIDRs)
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
