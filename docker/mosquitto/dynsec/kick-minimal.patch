+static bool acls__have(const struct dynsec__acl *acllist, bool allow)
+{
+	const struct dynsec__acl *acl, *acl_tmp = NULL;
+
+	HASH_ITER(hh, acllist, acl, acl_tmp){
+		if(acl->allow == allow){
+			return true;
+		}
+	}
+	return false;
+}
+
+bool dynsec_role__grants_subscribe(const struct dynsec__role *role)
+{
+	return acls__have(role->acls.subscribe_literal, true) || acls__have(role->acls.subscribe_pattern, true);
+}
+
+bool dynsec_role__restricts_subscribe(const struct dynsec__role *role)
+{
+	return role->allow_wildcard_subs == false
+			|| acls__have(role->acls.subscribe_literal, false) || acls__have(role->acls.subscribe_pattern, false);
+}
+
+/* The first matching rule decides, in the order of the roles. A role that leaves or moves can take away what it allowed,
+ * one that arrives or moves can take away with what it forbids. */
+bool dynsec_rolelist__change_can_revoke(struct dynsec__rolelist *old_list, struct dynsec__rolelist *new_list)
+{
+	struct dynsec__rolelist *item, *item_tmp = NULL, *other;
+
+	HASH_ITER(hh, old_list, item, item_tmp){
+		HASH_FIND(hh, new_list, item->rolename, strlen(item->rolename), other);
+		if((other == NULL || other->priority != item->priority) && dynsec_role__grants_subscribe(item->role)){
+			return true;
+		}
+	}
+	HASH_ITER(hh, new_list, item, item_tmp){
+		HASH_FIND(hh, old_list, item->rolename, strlen(item->rolename), other);
+		if((other == NULL || other->priority != item->priority) && dynsec_role__restricts_subscribe(item->role)){
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool acltype__is_subscribe(const char *acltype)
+{
+	return !strcasecmp(acltype, ACL_TYPE_SUB_LITERAL) || !strcasecmp(acltype, ACL_TYPE_SUB_PATTERN);
+}
